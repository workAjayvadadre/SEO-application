# Copy to .env and fill in what you have. Any platform without credentials is skipped, not fatal.

# ---------------------------------------------------------------------------
# SERP provider: powers Google, Quora discovery, and Instagram/Facebook discovery.
# One key is enough. Serper: https://serper.dev  |  SerpApi: https://serpapi.com
# ---------------------------------------------------------------------------
SERPER_API_KEY=
SERPAPI_API_KEY=
# serper | serpapi (optional; auto-detected from whichever key is set)
SERP_PROVIDER=
# Google "gl" country code and "hl" language (also used as YouTube regionCode / relevanceLanguage)
SEARCH_COUNTRY=us
SEARCH_LANGUAGE=en

# ---------------------------------------------------------------------------
# Reddit official API. Create a "script" app: https://www.reddit.com/prefs/apps
# Reddit requires a descriptive UA: <platform>:<app id>:<version> (by /u/<username>)
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:market-scraper:1.0 (by /u/your_reddit_username)
# relevance | hot | top | new | comments
REDDIT_SORT=relevance
# hour | day | week | month | year | all
REDDIT_TIME_FILTER=month
# How many top threads to pull comments from
REDDIT_COMMENT_POSTS=5

# ---------------------------------------------------------------------------
# YouTube Data API v3: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
# relevance | date | viewCount | rating
YOUTUBE_ORDER=relevance
YOUTUBE_COMMENT_VIDEOS=5

# ---------------------------------------------------------------------------
# Meta Graph API (Instagram + Facebook). Needs a Meta app and a long-lived token with
# instagram_basic, pages_read_engagement (+ "Page Public Content Access" for pages you don't manage).
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
# Optional, recommended: adds appsecret_proof to every call
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Your IG Business/Creator account id (required for hashtag search + business discovery)
IG_BUSINESS_ACCOUNT_ID=
# top_media | recent_media
IG_HASHTAG_EDGE=top_media
# Competitor/brand IG Business or Creator usernames to scan (comma-separated)
IG_DISCOVERY_USERNAMES=
# Facebook Page ids or usernames to scan (comma-separated)
FB_PAGE_IDS=
# Also find public IG/FB posts through the SERP provider (site:instagram.com ...)
META_SERP_DISCOVERY=true

# ---------------------------------------------------------------------------
# Quora (SERP discovery + optional answer extraction from question pages)
# ---------------------------------------------------------------------------
QUORA_FETCH_ANSWERS=true
QUORA_MAX_PAGES=5

# ---------------------------------------------------------------------------
# Headless browser for pages without APIs. Install first:
#   pip install playwright && playwright install chromium
# ---------------------------------------------------------------------------
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_PAGES=2

# ---------------------------------------------------------------------------
# Proxies: rotated round-robin for page fetches (official APIs are called directly).
# Format: http://user:pass@host:port, comma-separated, and/or a file with one per line.
# ---------------------------------------------------------------------------
PROXY_URLS=
PROXY_FILE=

# ---------------------------------------------------------------------------
# Resilience and performance
# ---------------------------------------------------------------------------
HTTP_TIMEOUT=20
MAX_RETRIES=4
BACKOFF_BASE=1.0
BACKOFF_MAX=30
MAX_CONCURRENCY=10
REQUESTS_PER_SECOND_PER_HOST=2
# Hard cap on how long any single platform may run
SOURCE_TIMEOUT=120

# Keyword engine: Google Suggest requests per second (lower it if you see 429s)
KEYWORD_RPS=8

# CLI defaults
DEFAULT_LIMIT=10
DEFAULT_COMMENTS=10

# Content writer ("Generate script" in the content planner) - Claude API.
# Get a key at https://platform.claude.com. Each script costs roughly a few US cents.
ANTHROPIC_API_KEY=
CONTENT_MODEL=claude-opus-5-5
# low | medium | high: higher = more careful writing, slower and costlier
CONTENT_EFFORT=medium
# Institution legal/brand name printed on every piece (NMC Cl. 8.3 i)
BRAND_NAME=
# Words that mark a search as about us / about a competitor (comma-separated)
OWN_BRAND_TERMS=indira
COMPETITOR_TERMS=
